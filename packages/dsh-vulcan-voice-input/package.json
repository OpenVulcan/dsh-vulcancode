{
  "name": "@openvulcan/dsh-vulcan-voice-input",
  "version": "0.4.3",
  "description": "Microphone dictation in DeepSeek Harness using OpenVulcan's free transcription service.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "!lib/**/*.test.*"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node ../../scripts/bundle-dsh-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"lib/**/*.test.js\""
  },
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@openvulcan/openvulcan-account": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@openvulcan/dsh-vulcan-account": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": { "access": "public" }
}
