{
  "name": "@openvulcan/dsh-vulcancode",
  "version": "0.4.4",
  "description": "VulcanCode for DeepSeek Harness (dsh): OpenVulcan account, Vulcan Decision permission guard, interactive answers, LuaSkills, long-term memory, custom thinking levels, voice input and the VulcanCode look. Community plugins, not affiliated with DeepSeek.",
  "license": "MIT",
  "icon": "./assets/openvulcan-icon.svg",
  "repository": { "type": "git", "url": "git+https://github.com/OpenVulcan/dsh-vulcancode.git", "directory": "packages/dsh-vulcancode" },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["assets", "cordis.patch.yml"],
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@openvulcan/dsh-decision-guard": "workspace:*",
    "@openvulcan/dsh-vulcan-account": "workspace:*",
    "@openvulcan/dsh-vulcan-answers": "workspace:*",
    "@openvulcan/dsh-vulcan-luaskills": "workspace:*",
    "@openvulcan/dsh-vulcan-memory": "workspace:*",
    "@openvulcan/dsh-vulcan-reasoning": "workspace:*",
    "@openvulcan/dsh-vulcan-style": "workspace:*",
    "@openvulcan/dsh-vulcan-voice-input": "workspace:*"
  },
  "publishConfig": { "access": "public" }
}
